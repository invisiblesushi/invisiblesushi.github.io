<section class="relative bg-background w-full max-w-screen-2xl text-center flex justify-center items-center px-4 py-20 sm:py-28">
  <div class="flex flex-col md:flex-row gap-12 w-full max-w-4xl justify-center items-start text-left">
    <!-- Profile Card Badge -->
    <div class="border border-border min-h-[320px] w-full md:w-[240px] bg-card p-5 rounded-2xl perfect-shadow flex flex-col justify-between shrink-0">
      <div class="w-full flex-1 bg-muted rounded-xl flex flex-col items-center justify-center p-6 text-center">
        <span class="text-4xl mb-3"></span>
        <h3 class="text-base font-semibold text-foreground">Daniel Chen</h3>
        <p class="text-xs text-muted-foreground mt-1">Software Engineer</p>
        <span class="inline-block mt-3 px-2.5 py-1 text-[11px] font-medium bg-emerald-500/10 text-emerald-600 rounded-full">
          Taiwan Gold Card
        </span>
      </div>

      <div class="pt-4 text-xs text-muted-foreground flex flex-col gap-1 border-t border-border mt-3">
        <div class="flex justify-between">
          <span>Location:</span>
          <span class="font-medium text-foreground">Taipei, Taiwan</span>
        </div>
        <div class="flex justify-between">
          <span>Primary:</span>
          <span class="font-medium text-foreground">C# / .NET / SQL / Python</span>
        </div>
      </div>
    </div>

    <!-- Bio & Skill Sets -->
    <div class="flex flex-1 flex-col gap-6">
      <div class="flex flex-col gap-2">
        <span class="text-xs font-semibold tracking-wider text-primary uppercase">About Me</span>
        <h2 class="text-2xl sm:text-4xl font-medium tracking-tight text-foreground">
          Software engineer specializing in C#, focused on building reliable, maintainable, and well-tested code.</h2>
      </div>

      <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed">
        Software engineer with a strong background in C#, .NET Core/Framework, and SQL, primarily focused on backend development, with additional experience in frontend technologies including ASP.NET and JavaScript. Native Norwegian with full professional proficiency in English and good spoken Mandarin Chinese, with intermediate reading and writing skills (self-assessed; approximately HSK 6 speaking and HSK 3 reading/writing, not officially certified). Seeking software engineering opportunities in Taiwan.
      </p>

      <!-- Technical Breakdown -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl border border-border bg-card">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Backend & .NET</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            C# (7.0, 8.0+), .NET Core, .NET Framework, ASP.NET Web API, Entity Framework, RESTful APIs, SOAP, HttpRequests, JSON & XML Serialization.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-card">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Database & Infrastructure</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Microsoft SQL Server (MS SQL), SQL, Stored Procedures, Schema Design, Linux servers, Vultr (VPS hosting & deployment).
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-card">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">DevOps, Mobile & AI Tools</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Kotlin, Android, Python, Java, JavaScript, Jenkins CI/CD, Octopus Deploy, Git, GitHub Actions, AI tooling (Cursor, GPT, GitHub Copilot).
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-card">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Languages & Communication</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            <strong>Norwegian:</strong> Native (Bokmål)<br />
            <strong>English:</strong> Full professional proficiency<br />
            <strong>Mandarin Chinese:</strong> Good spoken (~HSK 6), intermediate reading/writing (~HSK 3), (HSK is self-assessed)
          </p>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="https://www.linkedin.com/in/danielch045221182/"
          target="_blank"
          rel="noopener noreferrer"
          class="relative w-fit flex justify-center items-center px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-medium text-white bg-primary rounded-full perfect-shadow transition-transform hover:-translate-y-0.5"
        >
          Connect on LinkedIn ↗
          <div
            class="z-[-1] bg-gradient-to-b from-secondary via-primary to-primary absolute w-[calc(100%-4px)] h-[calc(100%-4px)] rounded-full border-t-2 border-secondary"
          >
          </div>
        </a>

        <a
          href="https://github.com/invisiblesushi"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit flex justify-center items-center px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-medium text-foreground bg-card border border-border rounded-full hover:bg-muted transition-all"
        >
          View GitHub ↗
        </a>
      </div>
    </div>
  </div>
</section>