---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Software Engineer",
  subtitle = "Software engineer with a strong background in C#, .NET Core/Framework, and SQL, primarily focused on backend development, with additional experience in frontend technologies including ASP.NET and JavaScript. Native Norwegian with full professional proficiency in English and good spoken Mandarin Chinese. Seeking software engineering opportunities in Taiwan.",
} = Astro.props;
---

<section class="w-full flex flex-col gap-6 justify-center items-center px-4 py-6 sm:py-6 text-center">
  <div class="flex flex-col gap-3 max-w-3xl items-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-card text-xs text-muted-foreground font-small mb-1">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Taiwan Gold Card Holder · Seeking Opportunities in Taiwan</span>
    </div>

    <h1 class="w-full text-4xl sm:text-6xl md:text-7xl font-medium tracking-tighter text-pretty text-foreground">
      {title}
    </h1>

    <p class="w-full text-muted-foreground text-base sm:text-lg md:text-xl font-light tracking-tight text-balance max-w-2xl leading-relaxed">
      {subtitle}
    </p>
  </div>

  <div class="w-full flex flex-wrap gap-4 items-center justify-center pt-2">
    <a
      href="/projects"
      class="relative w-fit flex justify-center items-center px-5 py-2.5 sm:px-6 sm:py-3 sm:text-base font-medium text-white bg-primary rounded-full perfect-shadow transition-transform hover:-translate-y-0.5 active:translate-y-0"
    >
      View Projects & Architecture
      <div
        class="z-[-1] bg-gradient-to-b from-secondary via-primary to-primary absolute w-[calc(100%-4px)] h-[calc(100%-4px)] rounded-full border-t-2 border-secondary"
      >
      </div>
    </a>

    <a
      href="https://www.linkedin.com/in/danielch045221182/"
      target="_blank"
      rel="noopener noreferrer"
      class="w-fit flex items-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 sm:text-base font-medium text-foreground bg-card border border-border rounded-full hover:bg-muted transition-all hover:-translate-y-0.5 active:translate-y-0"
    >
      LinkedIn Profile ↗
    </a>

    <a
      href="https://github.com/invisiblesushi"
      target="_blank"
      rel="noopener noreferrer"
      class="w-fit flex items-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 sm:text-base font-medium text-muted-foreground hover:text-foreground bg-transparent border border-border/80 rounded-full hover:bg-card transition-all"
    >
      GitHub ↗
    </a>
  </div>
</section>

<style>
  h1 {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.5, 1.15, 0.2, 1.1) forwards;
  }
  p {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.5, 1.15, 0.2, 1.1) 0.2s forwards;
  }
  div.pt-2 {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.5, 1.15, 0.2, 1.1) 0.4s forwards;
  }
</style>
