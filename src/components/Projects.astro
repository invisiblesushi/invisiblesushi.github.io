            </div>
            {project3.data.publishDate && (
              <span class="text-xs text-gray-400">{project3.data.publishDate.getFullYear()}</span>
            )}
          </div>
          <h3 class="text-xl sm:text-2xl font-medium tracking-tight bg-clip-text text-transparent bg-gradient-to-br from-white via-white to-secondary">
            <a href={`/projects/${project3.id}`} class="hover:underline">{project3.data.title}</a>
          </h3>
          <p class="text-gray-300 text-sm sm:text-base font-light line-clamp-3">
            {project3.data.description}
          </p>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {project3.data.tags.slice(0, 5).map((tag) => (
              <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-white/10 text-gray-200">{tag}</span>
            ))}
          </div>
        </div>

        <div class="flex items-center justify-between pt-6 mt-auto text-sm font-medium border-t border-dark-border">
          <a href={`/projects/${project3.id}`} class="text-secondary hover:underline flex items-center gap-1">
            View Project →
          </a>
          <div class="flex items-center gap-3">
            {project3.data.liveUrl && (
              <a href={project3.data.liveUrl} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white">
                Demo ↗
              </a>
            )}
            {project3.data.githubUrl ? (
              <a href={project3.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white">
                GitHub ↗
              </a>
            ) : project3.data.isCommercial ? (
              <div class="flex items-center gap-2">
                {project3.data.companyUrl && (
                  <a
                    href={project3.data.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-amber-300/80 hover:text-amber-300 text-xs"
                  >
                    zeekit.no ↗
                  </a>
                )}
                <span class="text-gray-500 text-xs italic">
                  Enterprise IP
                </span>
              </div>
            ) : null}
          </div>
        </div>
      </article>
    )}

    <!-- Let's work together Bento Card -->
    <article class="overflow-hidden bg-dark-card col-span-1 md:col-span-2 border border-dark-border rounded-2xl p-6 flex flex-col gap-4 justify-center items-center text-center min-h-[280px]">
      <h3 class="text-xl sm:text-2xl font-medium tracking-tight bg-clip-text text-transparent bg-gradient-to-br from-white via-white to-secondary">
        Looking for a C# Engineer?
      </h3>
      <p class="text-gray-400 text-xs sm:text-sm font-light max-w-xs">
        Seeking software engineering opportunities in Taiwan. Let's discuss how I can contribute to your engineering team.
      </p>
      <a
        href="https://www.linkedin.com/in/danielch045221182/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-fit flex gap-2 justify-center items-center px-5 py-2 text-sm font-medium text-white bg-primary rounded-full hover:brightness-110 transition-all perfect-shadow"
      >
        Connect on LinkedIn
      </a>
    </article>
  </div>

  <div class="z-10 mt-2">
    <a href="/projects" class="inline-flex items-center gap-2 text-sm text-secondary hover:underline font-medium">
      View full project archive ({allProjects.length}) →
    </a>
  </div>
</section>
